    "edgeAcceleration": 1.0,
    "edgeMomentum": 0.15,
    "edgeStartMM": 3,
    "edgeStepMM": 5,
    "edgeZoneWidth": 0.18,
    "middleZoneWidth": 0.1,
    "swipeMinMM": 10,
