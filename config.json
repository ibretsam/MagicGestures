      "media": "volumedown-fine",
      "stepMM": 2.5
    },
    "edge-left-up": {
      "media": "volumeup-fine",
      "stepMM": 2.5
    },
    "swipe3-down": {
      "keys": "ctrl+down"
    },
    "swipe3-left": {
      "keys": "cmd+shift+["
    },
    "swipe3-right": {
      "keys": "cmd+shift+]"
    },
    "swipe3-up": {
